# WEBFORGE AI — example configuration. Copy to `.env` (Git-ignored) and `chmod 600 .env`.
# Every value here is a placeholder. Never commit real secrets.
# Generate a secret:          python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Generate ENCRYPTION_KEY:    python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"

# --- Application ---------------------------------------------------------
APP_ENV=development
APP_NAME=WEBFORGE_AI
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
PREVIEW_BASE_URL=http://localhost:4000
TIMEZONE=Asia/Karachi
LOG_LEVEL=INFO
# Browser origins allowed to make state-changing requests (dashboard URL[s]). Comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Dashboard (server-side only; never exposed to the browser) ----------
# URL the dashboard server uses to reach the API. Inside Compose this is the service name.
API_INTERNAL_URL=http://api:8000
# Forward the browser's X-Forwarded-For to the API. Set true ONLY behind a reverse proxy
# (Caddy, Phase 11) that overwrites the header; otherwise clients could spoof their IP.
DASHBOARD_TRUST_FORWARDED_FOR=false

# --- Local Docker Compose PostgreSQL ------------------------------------
# Used by the postgres container. Keep the password in sync with DATABASE_URL.
POSTGRES_USER=webforge
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=webforge

# --- Local Docker Compose Redis -----------------------------------------
# Used by the redis container. Keep it in sync with the Redis URLs below.
REDIS_PASSWORD=CHANGE_ME

# --- Database / queue ----------------------------------------------------
DATABASE_URL=postgresql+psycopg://webforge:CHANGE_ME@postgres:5432/webforge
REDIS_URL=redis://:CHANGE_ME@redis:6379/0
CELERY_BROKER_URL=redis://:CHANGE_ME@redis:6379/1
CELERY_RESULT_BACKEND=redis://:CHANGE_ME@redis:6379/2
READINESS_TIMEOUT_SECONDS=2

# --- Auth / encryption (required; `make env` generates real random values) --
# APP_SECRET_KEY: CSRF token key. JWT_SIGNING_KEY: access-token signing + token hashing.
# ENCRYPTION_KEY: AES-256-GCM key for contact data and MFA secrets (32 bytes, URL-safe base64).
# LOOKUP_HASH_KEY: keyed hash for email/suppression lookups. Never rotate it without re-hashing.
# All four must differ. Rotating JWT_SIGNING_KEY signs everyone out.
APP_SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
JWT_SIGNING_KEY=GENERATE_A_DIFFERENT_LONG_RANDOM_SECRET
ENCRYPTION_KEY=GENERATE_USING_SUPPORTED_32_BYTE_FORMAT
# Set to the old ENCRYPTION_KEY during rotation (decrypt-only), then clear after re-encryption.
ENCRYPTION_KEY_PREVIOUS=
LOOKUP_HASH_KEY=GENERATE_A_THIRD_LONG_RANDOM_SECRET
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_MAX_DAYS=30
MFA_PENDING_MINUTES=5
# Applies to OWNER and ADMIN accounts. Must be true in production.
MFA_REQUIRED_FOR_OWNER=true
# Secure cookies (__Host- prefix). Must be true in production; false only for plain-http local dev.
COOKIE_SECURE=false
# Proxies whose X-Forwarded-For is trusted (the dashboard container network in Compose).
TRUSTED_PROXY_CIDRS=127.0.0.1/32,172.28.0.0/24
LOGIN_RATE_LIMIT_PER_IP_PER_MINUTE=10
LOGIN_RATE_LIMIT_PER_ACCOUNT_PER_HOUR=20
ACCOUNT_LOCKOUT_THRESHOLD=10
ACCOUNT_LOCKOUT_MINUTES=15

# --- AI design briefs (Phase 05) -----------------------------------------
# AI design briefs (Phase 05). `mock` is free, offline and refused in production.
# `anthropic` needs ANTHROPIC_API_KEY (server-side only) and a non-zero daily budget.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Empty = the default model pinned in services/ai.py (DEFAULT_MODEL).
ANTHROPIC_MODEL=
AI_EFFORT=high
AI_MAX_INPUT_TOKENS_PER_JOB=30000
AI_MAX_OUTPUT_TOKENS_PER_JOB=16000
# US cents per UTC day; 0 blocks every paid AI call. Reserved at worst case before each call.
AI_DAILY_BUDGET_MINOR=0
AI_REQUEST_TIMEOUT_SECONDS=300
# Regeneration attempts after a schema/integrity failure (each is billed).
AI_MAX_REPAIR_ATTEMPTS=2

# --- Concept renderer (Phase 06) ----------------------------------------
# Shown as plain text on every concept page and proposal ("prepared by").
CONCEPT_AUTHOR_NAME=Muhammad Aqib
CONCEPT_AUTHOR_URL=https://aqibkhn.space
CONCEPT_AUTHOR_TITLE=Website Developer
CONCEPT_AUTHOR_GITHUB=https://github.com/10-aqib

# --- Proposals and previews (Phase 08) -----------------------------------
# Reply address printed in the proposal's next step. Leave empty until you have a professional mailbox.
PROPOSAL_CONTACT_EMAIL=
# Previews are served from their own origin (container `preview`, PREVIEW_BASE_URL above); proposal PDFs
# expire after ARTIFACT_RETENTION_DAYS and preview links after PREVIEW_RETENTION_DAYS.
PREVIEW_RATE_LIMIT_PER_MINUTE=120

# --- Google Places API (New) — see docs/compliance/source-policies.md ------
# Master switch. The source must ALSO be terms-reviewed and enabled by the owner in the dashboard.
# Restrict the key to the Places API (New) and the server IP in Google Cloud. Never commit it.
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_ENABLED=false
# Budgets/caps: 0 blocks all paid requests (fail closed).
GOOGLE_PLACES_DAILY_BUDGET_MINOR=0
GOOGLE_PLACES_DAILY_REQUEST_CAP=0
GOOGLE_PLACES_MAX_REQUESTS_PER_CAMPAIGN=0
GOOGLE_PLACES_RATE_LIMIT_PER_MINUTE=30
# Copy current prices from Google's price list (minor units per 1000 requests). SKUs used:
# TEXT_SEARCH_PRO (search preview), PLACE_DETAILS_ENTERPRISE (website lookup),
# PLACE_DETAILS_IDS_ONLY (Place ID refresh). An unpriced SKU is refused.
# Example shape only (NOT real prices): {"TEXT_SEARCH_PRO": 0, "PLACE_DETAILS_ENTERPRISE": 0}
GOOGLE_PLACES_SKU_PRICES_MINOR_PER_1000={}
GOOGLE_PLACES_PRICE_CURRENCY=USD
GOOGLE_PLACES_LANGUAGE_CODE=en

# --- Browser sandbox (website audits) ----------------------------------------
# Internal URL of the isolated browser service. It has no secrets and reaches the internet
# only through the SSRF-filtering egress proxy.
BROWSER_SERVICE_URL=http://browser:9000
AUDIT_VERSION=1

# --- Official-website verification ----------------------------------------
# Identifies the verifier to website owners. Add a contact URL you control if you wish.
WEBSITE_FETCH_USER_AGENT=WEBFORGE-AI-Verifier/0.2 (website verification; respects robots.txt)

# --- Email (Phase 09; only `mock` exists; sending `true` is rejected) -----
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
EMAIL_FROM_NAME=Muhammad Aqib
EMAIL_FROM_ADDRESS=
EMAIL_REPLY_TO=
EMAIL_SENDING_ENABLED=false
EMAIL_DAILY_MAX=0
EMAIL_HOURLY_MAX=0
EMAIL_MONTHLY_BUDGET_MINOR=0
EMAIL_WEBHOOK_SECRET=
EMAIL_INBOUND_SIGNING_SECRET=
EMAIL_PROVIDER_POLICY_APPROVED=false
# Phase 09 disclosures/confirmations (all checked before every send; empty/false = HOLD).
EMAIL_PHYSICAL_ADDRESS=
EMAIL_PROVIDER_APPROVAL_REF=
EMAIL_DOMAIN_AUTHENTICATED=false
EMAIL_WEBHOOK_TOLERANCE_SECONDS=300

# --- Object storage --------------------------------------------------------
# local = private Docker volume (dev/single VPS); s3 = S3-compatible bucket (needs S3_* below).
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/data/artifacts
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
ARTIFACT_RETENTION_DAYS=90
PREVIEW_RETENTION_DAYS=30

# --- Limits / worker runtime --------------------------------------------
BROWSER_MAX_PAGES=10
BROWSER_MAX_DEPTH=2
BROWSER_PAGE_TIMEOUT_SECONDS=30
BROWSER_MAX_RESPONSE_BYTES=5242880
BROWSER_JOB_TIMEOUT_SECONDS=300
DISCOVERY_WORKER_CONCURRENCY=2
AUDIT_WORKER_CONCURRENCY=1
DESIGN_WORKER_CONCURRENCY=1
RENDER_WORKER_CONCURRENCY=1
OUTREACH_WORKER_CONCURRENCY=1
# Emergency overrides. The normal pause switches are in the dashboard (Settings) and are stored
# in the database, starting PAUSED. Setting either of these to true forces the pause on
# regardless of the dashboard (use during incidents; requires a restart to take effect).
GLOBAL_PAUSE=false
EMAIL_PAUSE=false

# --- Monitoring / backup (Phase 11) -------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
BACKUP_BUCKET=
BACKUP_ENCRYPTION_KEY_REF=
ALERT_EMAIL_TO=
# Optional HTTPS webhook you control (e.g. ntfy, chat). Ops alerts are POSTed here as JSON.
ALERT_WEBHOOK_URL=

# --- Backups (Phase 11) ----------------------------------------------------
# urlsafe base64 of 32 random bytes. Store a copy OFF the server: without it backups cannot be restored.
BACKUP_ENCRYPTION_KEY=
# Local directory on the VPS for encrypted backups (also copied off-site when BACKUP_S3_BUCKET is set).
BACKUP_DIR=/var/backups/webforge
BACKUP_KEEP_DAYS=14
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT_URL=
BACKUP_S3_REGION=
BACKUP_S3_PREFIX=webforge/
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# --- Production hostnames (Phase 11; used by Caddy only) ---------------------
# Use only domains you control, e.g. app.<domain>, api.<domain>, preview.<domain>. APP_URL, API_URL and
# PREVIEW_BASE_URL above must be the matching https:// URLs.
APP_DOMAIN=
API_DOMAIN=
PREVIEW_DOMAIN=
RELEASE_TAG=dev
